<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Khuôn schema đơn vị-năm: nhúng thẳng vào .dll để bản publish (xcopy) không
         bao giờ thiếu file, và không ai sửa được schema trên server mà không build lại. -->
    <EmbeddedResource Include="..\database\010_tenant_template_v6.sql"
                      LogicalName="KT2000.Api.tenant_template.sql" />

    <!-- Bộ bảng nội bộ (NB): danh mục DM_KH_NB/DM_HANG_NB (013+014), rồi vá khuôn
         HOA_DON + gói hàng (015). Tách file riêng chứ không gộp vào 010 để 010 giữ
         nguyên vai "bản sao đúng của TUAN_NGA_2025".
         Chạy cho MỌI tenant theo AD-NB-09 — tenant thuế chỉ thừa mấy bảng rỗng và
         mấy cột trống (ma_nvkd/ma_nvvc/ma_goi), đúng nguyên tắc "cột thừa để trống
         theo CẢ HAI CHIỀU" của SPEC mục 4. THỨ TỰ TRONG DANH SÁCH LÀ THỨ TỰ CHẠY. -->
    <EmbeddedResource Include="..\database\013_tenant_nb_donhang.sql"
                      LogicalName="KT2000.Api.tenant_nb.sql" />
    <EmbeddedResource Include="..\database\014_tenant_nb_bosung.sql"
                      LogicalName="KT2000.Api.tenant_nb_bosung.sql" />
    <EmbeddedResource Include="..\database\015_nb_hoadon_goi.sql"
                      LogicalName="KT2000.Api.tenant_nb_hoadon_goi.sql" />
    <EmbeddedResource Include="..\database\017_goi_hd_line_tri_gia.sql"
                      LogicalName="KT2000.Api.tenant_nb_tri_gia.sql" />

    <!-- Bộ tải HĐ của TCT đi kèm bản build: TctFetchService gọi nó bằng Process.Start
         theo đường dẫn <thư mục exe>\tools\. Copy chứ không nhúng, vì python.exe cần
         file thật trên đĩa. Đè được bằng khóa Paths:TctScript nếu muốn để nơi khác. -->
    <None Include="..\tools\TRA_CUU_HDDT_2_0.py" Link="tools\TRA_CUU_HDDT_2_0.py"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tools\XML_MAP.xlsx" Link="tools\XML_MAP.xlsx"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
